{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpe-passport",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cpe-passport-production",
      "database_id": "dea0b862-4e75-494e-84ef-8c2b200a0683",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "cpe-passport-production"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  },
  "vars": {
    "APP_URL": "https://cpe.scribo.com.hk",
    "EMAIL_MODE": "outbox",
    "TEST_EMAIL_ALLOWLIST": "will.kwan@scribo.com.hk,anthony.fan@scribo.com.hk",
    "MAX_UPLOAD_BYTES": "10485760",
    "REMINDER_LEAD_DAYS": "30,7"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "cpe.scribo.com.hk",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
