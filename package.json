{
  "name": "cpe-passport",
  "description": "Scribo Hong Kong pharmacist CPE passport \u2014 Phase 1 demonstration",
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.11.1",
    "lucide-react": "^0.577.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^4.20260730.0",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "4.136.1"
  },
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file migrations/seed.sql",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "reminders:simulate": "node scripts/simulate-reminders.mjs",
    "samples": "node scripts/create-sample-documents.mjs"
  },
  "type": "module"
}
